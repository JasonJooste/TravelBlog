{%-comment-%}
  RSS 2.0 feed for one language.
  Params: lng ("en" or "fr"), feed_path (e.g. "/feed.xml"), description, limit
  Post images written as "(:slug/file.jpg)" are rewritten to absolute
  /assets/img/posts/ URLs so they load in feed readers.
{%-endcomment-%}
{%- assign img_base = site.url | append: site.baseurl | append: '/assets/img/posts/' -%}
{%- assign abs_base = site.url | append: site.baseurl | append: '/' -%}
{%- assign limit = include.limit | default: 20 -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.data.owner[include.lng].brand | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/{% if include.lng != "en" %}{{ include.lng }}/{% endif %}</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}{{ include.feed_path }}" rel="self" type="application/rss+xml"/>
    <description>{{ include.description | xml_escape }}</description>
    <language>{{ include.lng }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {%- assign count = 0 -%}
    {%- for post in site.posts -%}
      {%- assign is_fr = false -%}
      {%- if post.path contains 'fr/_posts/' -%}{%- assign is_fr = true -%}{%- endif -%}
      {%- if include.lng == "fr" and is_fr == false -%}{%- continue -%}{%- endif -%}
      {%- if include.lng != "fr" and is_fr -%}{%- continue -%}{%- endif -%}
      {%- if count >= limit -%}{%- break -%}{%- endif -%}
      {%- assign count = count | plus: 1 -%}
      {%- capture img_src -%}src="{{ img_base }}{%- endcapture -%}
      {%- capture abs_src -%}src="{{ abs_base }}{%- endcapture -%}
      {%- capture abs_href -%}href="{{ abs_base }}{%- endcapture -%}
      {%- assign body = post.content | replace: 'src=":', img_src | replace: 'src="/', abs_src | replace: 'href="/', abs_href -%}
      {%- assign link = post.url | absolute_url %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ link }}</link>
      <guid isPermaLink="true">{{ link }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {%- for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
      {%- endfor %}
      <description>{{ body | xml_escape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
